generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum AccountType {
  STAFF
  READER
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  BREAKING_NEWS
  NEW_ARTICLE
  RECOMMENDATION
  SYSTEM
  JOB_ALERT
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum HomepageSectionType {
  HERO
  LATEST
  BANGLADESH
  WORLD
  POLITICS
  BUSINESS
  SPORTS
  TECHNOLOGY
  ENTERTAINMENT
  TRENDING
  MOST_READ
  CUSTOM
}

enum HomepageConfigurationStatus {
  ACTIVE
  DRAFT
}

/// Where a homepage section gets its stories from.
/// MANUAL uses the section's HomepagePlacement rows (editor-picked, ordered).
/// Every other value is resolved automatically at read time from published articles.
enum HomepageSourceType {
  MANUAL
  LATEST
  CATEGORY
  TAG
  LOCATION
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR_IN_CHIEF
  EDITOR
  REPORTER
  PHOTOGRAPHER
  CONTRIBUTOR
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Bangladesh keeps its exact original levels (COUNTRY/DIVISION/DISTRICT/UPAZILA). The rest support a
/// global hierarchy without forcing every country into that same shape — a location's real parent chain
/// (via parentId) is what matters; `type` is a label, not a fixed depth.
enum LocationType {
  CONTINENT
  COUNTRY
  STATE
  PROVINCE
  REGION
  DIVISION
  DISTRICT
  COUNTY
  CITY
  MUNICIPALITY
  UPAZILA
  SUBDISTRICT
  OTHER
}

/// bn is the platform default; en is the second supported language. Admin-managed via the Languages
/// module — enable/disable and default are data (isActive/isDefault), never hardcoded in code.
model Language {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  nativeName String   @map("native_name")
  direction  String   @default("ltr")
  isActive   Boolean  @default(true) @map("is_active")
  isDefault  Boolean  @default(false) @map("is_default")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  articles             Article[]
  categoryTranslations CategoryTranslation[]
  tagTranslations      TagTranslation[]
  locationTranslations LocationTranslation[]

  @@map("languages")
}

/// One localized name per (location, language). The base Location.name/slug stay the canonical
/// administrative identity; a translation only changes what is displayed.
model LocationTranslation {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  languageId String   @map("language_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([locationId, languageId])
  @@map("location_translations")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum TagStatus {
  ACTIVE
  INACTIVE
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// Job posting workflow (Phase 2O) — mirrors ArticleStatus's DRAFT→IN_REVIEW→APPROVED→PUBLISHED→
/// ARCHIVED shape with two job-specific additions: SCHEDULED (a job approved for a future publishAt,
/// same idea as Article's own scheduling) and EXPIRED (deadline passed while still PUBLISHED — a
/// distinct state from ARCHIVED, which is an admin's deliberate takedown).
enum JobStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum JobCategoryStatus {
  ACTIVE
  INACTIVE
}

enum EmployerStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

/// How a candidate actually applies. INTERNAL means the application form lives on this platform and
/// produces a JobApplication row; EXTERNAL_URL/EMAIL mean the "Apply Now" action sends the candidate
/// off-platform (an employer's own site, or a plain mailto:) and no JobApplication row is created.
enum ApplicationMethod {
  INTERNAL
  EXTERNAL_URL
  EMAIL
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

// ==================== MODELS ====================

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles               UserRoleAssignment[]
  authoredArticles        Article[]                  @relation("ArticleAuthor")
  reviewedArticles        Article[]                  @relation("ArticleReviewer")
  assignedArticles        Article[]                  @relation("ArticleAssignee")
  createdBreakingNews     BreakingNews[]              @relation("BreakingNewsCreatedBy")
  updatedBreakingNews     BreakingNews[]              @relation("BreakingNewsUpdatedBy")
  breakingNewsAuditLogs   BreakingNewsAuditLog[]
  sessions                Session[]
  uploadedMedia           Media[]
  revisedArticles         ArticleRevision[]
  comments                Comment[]                  @relation("CommentAuthor")
  moderatedComments       Comment[]                  @relation("CommentModerator")
  createdAds              Ad[]
  accountType             AccountType                @default(STAFF) @map("account_type")
  verifiedAt              DateTime?                  @map("verified_at")
  readerProfile           ReaderProfile?
  bookmarks               Bookmark[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  createdCollections      EditorialCollection[]
  articleNotes            ArticleNote[]
  corrections             ArticleCorrection[]
  auditLogEntries         ArticleAuditLog[]
  preferenceCategories    ReaderPreferenceCategory[]
  preferenceLocations     ReaderPreferenceLocation[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // Jobs platform (Phase 2O)
  createdJobs        Job[]             @relation("JobCreatedBy")
  updatedJobs        Job[]             @relation("JobUpdatedBy")
  jobAuditLogEntries JobAuditLog[]
  savedJobs          SavedJob[]
  resumes            Resume[]
  jobApplications    JobApplication[]
  reviewedApplications JobApplication[] @relation("ApplicationReviewer")
  createdEmployers   Employer[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Location {
  id          String         @id @default(uuid())
  name        String
  slug        String
  type        LocationType
  parentId    String?        @map("parent_id")
  identityKey String         @unique @map("identity_key")
  status      LocationStatus @default(ACTIVE)
  /// ISO 3166-1 alpha-2, set on COUNTRY rows (and useful on CONTINENT/STATE rows for filtering).
  countryCode String?        @map("country_code")
  latitude    Float?
  longitude   Float?
  timezone    String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  parent            Location?                  @relation("LocationTree", fields: [parentId], references: [id])
  children          Location[]                 @relation("LocationTree")
  articles          Article[]
  readerPreferences ReaderPreferenceLocation[]
  homepageSections  HomepageSection[]
  translations      LocationTranslation[]
  jobs              Job[]
  employers         Employer[]

  @@unique([type, parentId, slug])
  @@index([slug])
  @@index([parentId])
  @@index([status])
  @@index([countryCode])
  @@map("locations")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  parentId    String?        @map("parent_id")
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  parent            Category?                  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]                 @relation("CategoryTree")
  articles          Article[]
  readerPreferences ReaderPreferenceCategory[]
  homepageSections  HomepageSection[]
  translations      CategoryTranslation[]

  @@index([slug])
  @@index([status])
  @@map("categories")
}

/// Localized display name (and, for URL consistency, a per-language slug — defaults to the base slug
/// so /category/:slug stays language-agnostic unless an editor deliberately gives a language its own URL).
model CategoryTranslation {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  languageId  String   @map("language_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@unique([languageId, slug])
  @@map("category_translations")
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    TagStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  articleTags      ArticleTag[]
  homepageSections HomepageSection[]
  translations     TagTranslation[]

  @@index([slug])
  @@map("tags")
}

/// One tag, many localized names/slugs — never two unrelated tags for the same concept.
model TagTranslation {
  id         String   @id @default(uuid())
  tagId      String   @map("tag_id")
  languageId String   @map("language_id")
  name       String
  slug       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageId])
  @@unique([languageId, slug])
  @@map("tag_translations")
}

/// Groups Article rows that are translations of one another. A source article gets one of these the
/// moment its first translation is created; a standalone article (no group) has no known translations.
model ArticleTranslationGroup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  articles Article[]

  @@map("article_translation_groups")
}

model Article {
  id                 String        @id @default(uuid())
  title              String
  slug               String        @unique
  excerpt            String?
  content            Json?
  seoTitle           String?       @map("seo_title")
  seoDescription     String?       @map("seo_description")
  seoKeywords        String?       @map("seo_keywords")
  canonicalUrl       String?       @map("canonical_url")
  noIndex            Boolean       @default(false) @map("no_index")
  status             ArticleStatus @default(DRAFT)
  authorId           String        @map("author_id")
  categoryId         String?       @map("category_id")
  featuredImageId    String?       @map("featured_image_id")
  locationId         String?       @map("location_id")
  /// Nullable only for rows that predate Phase 2C; every public read treats null as the default language.
  languageId         String?       @map("language_id")
  /// Set once this article has at least one translation; shared by every language version of the same story.
  translationGroupId String?       @map("translation_group_id")
  publishedAt        DateTime?     @map("published_at")
  reviewedAt         DateTime?     @map("reviewed_at")
  reviewedById       String?       @map("reviewed_by_id")
  archivedAt         DateTime?     @map("archived_at")
  // Breaking news fields
  isBreaking         Boolean?      @default(false) @map("is_breaking")
  breakingStartedAt  DateTime?     @map("breaking_started_at")
  breakingEndsAt     DateTime?     @map("breaking_ends_at")
  breakingPriority   Int?          @map("breaking_priority")
  // Scheduling fields
  scheduledAt        DateTime?     @map("scheduled_at")
  // Assignment fields (Phase 2L) — who is currently responsible for moving this article forward,
  // separate from authorship: an editor can assign a story to a reporter/writer without changing who
  // wrote it, and reassignment is just calling assign() again (no history kept beyond the audit log).
  assigneeId         String?       @map("assignee_id")
  assignedAt         DateTime?     @map("assigned_at")
  assignmentNote     String?       @map("assignment_note")
  // View tracking
  viewCount          Int           @default(0) @map("view_count")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  author             User                     @relation("ArticleAuthor", fields: [authorId], references: [id])
  assignee           User?                    @relation("ArticleAssignee", fields: [assigneeId], references: [id])
  category           Category?                @relation(fields: [categoryId], references: [id])
  location           Location?                @relation(fields: [locationId], references: [id])
  media              Media?                   @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id])
  reviewedBy         User?                    @relation("ArticleReviewer", fields: [reviewedById], references: [id])
  language           Language?                @relation(fields: [languageId], references: [id])
  translationGroup   ArticleTranslationGroup? @relation(fields: [translationGroupId], references: [id])
  articleTags        ArticleTag[]
  views              ArticleView[]
  revisions          ArticleRevision[]
  comments           Comment[]
  bookmarks          Bookmark[]
  collectionItems    ArticleCollection[]
  notes              ArticleNote[]
  corrections        ArticleCorrection[]
  auditLogs          ArticleAuditLog[]
  notifications      Notification[]
  homepagePlacements HomepagePlacement[]
  breakingNewsItems  BreakingNews[]
  manualRelated      ArticleRelated[] @relation("RelatedSource")
  manuallyRelatedTo  ArticleRelated[] @relation("RelatedTarget")

  @@unique([translationGroupId, languageId])
  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([locationId])
  @@index([featuredImageId])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([isBreaking])
  @@index([breakingPriority])
  @@index([scheduledAt])
  @@index([assigneeId])
  @@index([status, publishedAt])
  @@index([status, isBreaking])
  @@index([languageId])
  @@index([translationGroupId])
  @@map("articles")
}

/// Editor-curated related stories. Automatic recommendations remain computed at read time and fill
/// any remaining slots after these ordered rows.
model ArticleRelated {
  articleId        String   @map("article_id")
  relatedArticleId String   @map("related_article_id")
  position         Int
  createdAt        DateTime @default(now()) @map("created_at")

  article        Article @relation("RelatedSource", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle Article @relation("RelatedTarget", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@id([articleId, relatedArticleId])
  @@unique([articleId, position])
  @@index([relatedArticleId])
  @@map("article_related")
}

model ArticleView {
  id          String   @id @default(uuid())
  articleId   String   @map("article_id")
  sessionId   String?  @map("session_id")
  fingerprint String?  @map("fingerprint")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([viewedAt])
  @@index([articleId, viewedAt])
  @@index([fingerprint])
  @@map("article_views")
}

model ArticleRevision {
  id              String   @id @default(uuid())
  articleId       String   @map("article_id")
  version         Int
  title           String
  excerpt         String?
  content         Json?
  slug            String
  categoryId      String?  @map("category_id")
  locationId      String?  @map("location_id")
  featuredImageId String?  @map("featured_image_id")
  authorId        String   @map("author_id")
  status          String
  changedById     String   @map("changed_by_id")
  changeReason    String?  @map("change_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@unique([articleId, version])
  @@index([articleId])
  @@index([changedById])
  @@index([createdAt])
  @@map("article_revisions")
}

model ArticleTag {
  articleId String   @map("article_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

model Media {
  id               String   @id @default(uuid())
  filename         String
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  size             Int
  width            Int?
  height           Int?
  storageKey       String   @unique @map("storage_key")
  publicUrl        String   @map("public_url")
  altText          String?  @map("alt_text")
  caption          String?
  credit           String?
  uploadedById     String   @map("uploaded_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  uploadedBy       User                  @relation(fields: [uploadedById], references: [id])
  featuredArticles Article[]             @relation("ArticleFeaturedImage")
  ads              Ad[]
  collectionCovers EditorialCollection[]
  readerAvatars    ReaderProfile[]       @relation("ReaderAvatar")
  employerLogos    Employer[]            @relation("EmployerLogo")
}

model ReaderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  displayName       String
  preferredLanguage String   @default("en") @map("preferred_language")
  avatarMediaId     String?  @map("avatar_media_id")
  phone             String?
  bio               String?
  location          String?
  theme             String   @default("SYSTEM")
  profilePublic     Boolean  @default(false) @map("profile_public")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar Media? @relation("ReaderAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([avatarMediaId])

  @@map("reader_profiles")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
  @@index([articleId])
  @@map("bookmarks")
}

model ReaderPreferenceCategory {
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
  @@map("reader_preference_categories")
}

model ReaderPreferenceLocation {
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
  @@map("reader_preference_locations")
}

model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  breakingNews Boolean  @default(true) @map("breaking_news")
  categoryNews Boolean  @default(true) @map("category_news")
  locationNews Boolean  @default(true) @map("location_news")
  jobAlerts    Boolean  @default(false) @map("job_alerts")
  accountSecurity Boolean @default(true) @map("account_security")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  articleId String?          @map("article_id")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([articleId])
  @@map("notifications")
}

model EditorialCollection {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  description  String?
  coverImageId String?          @map("cover_image_id")
  status       CollectionStatus @default(DRAFT)
  createdById  String           @map("created_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  coverImage Media?              @relation(fields: [coverImageId], references: [id])
  createdBy  User                @relation(fields: [createdById], references: [id])
  articles   ArticleCollection[]

  @@index([status])
  @@index([createdAt])
  @@map("editorial_collections")
}

model ArticleCollection {
  articleId    String   @map("article_id")
  collectionId String   @map("collection_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  article    Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collection EditorialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([articleId, collectionId])
  @@index([collectionId, sortOrder])
  @@map("article_collections")
}

/// A section belongs to exactly one HomepageConfiguration (the live ACTIVE one or the editable DRAFT).
/// `key` is the stable identity inside a configuration and is shared by the ACTIVE and DRAFT copy of
/// the same section: lower(type) for singleton types, custom-<suffix> for repeatable CUSTOM sections.
/// `layoutType` holds a validated preset (FEATURED_STACK | THREE_UP | COMPACT_LIST), enforced by the service.
model HomepageSection {
  id              String              @id @default(uuid())
  configurationId String              @map("configuration_id")
  type            HomepageSectionType
  key             String
  title           String
  enabled         Boolean             @default(true)
  sortOrder       Int                 @default(0) @map("sort_order")
  sourceType      HomepageSourceType  @default(MANUAL) @map("source_type")
  categoryId      String?             @map("category_id")
  locationId      String?             @map("location_id")
  tagId           String?             @map("tag_id")
  maxItems        Int                 @default(4) @map("max_items")
  layoutType      String              @default("FEATURED_STACK") @map("layout_type")
  /// Presentation override: "AUTO" lets the layout choose the NewsCard variant.
  cardVariant     String              @default("AUTO") @map("card_variant")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  configuration HomepageConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [categoryId], references: [id])
  location      Location?             @relation(fields: [locationId], references: [id])
  tag           Tag?                  @relation(fields: [tagId], references: [id])
  placements    HomepagePlacement[]

  @@unique([configurationId, key])
  @@index([enabled, sortOrder])
  @@index([configurationId, sortOrder])
  @@index([tagId])
  @@map("homepage_sections")
}

/// Homepage configuration boundary. INVARIANT: at most one row per status (unique index on `status`),
/// so "which homepage is live?" is always the single ACTIVE row. The DRAFT row is the persistent
/// single working copy; `version` is bumped on every draft mutation (optimistic concurrency) and on
/// every publish of the ACTIVE row. Publishing copies DRAFT -> ACTIVE inside one transaction.
model HomepageConfiguration {
  id          String                      @id @default(uuid())
  status      HomepageConfigurationStatus @unique
  version     Int                         @default(1)
  publishedAt DateTime?                   @map("published_at")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  sections HomepageSection[]

  @@map("homepage_configurations")
}

model HomepagePlacement {
  sectionId String @map("section_id")
  articleId String @map("article_id")
  sortOrder Int    @default(0) @map("sort_order")

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  article Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([sectionId, articleId])
  @@index([sectionId, sortOrder])
  @@map("homepage_placements")
}

model NewsletterSubscriber {
  id             String           @id @default(uuid())
  email          String           @unique
  status         SubscriberStatus @default(PENDING)
  subscribedAt   DateTime         @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")
  verifiedAt     DateTime?        @map("verified_at")

  @@index([status])
  @@map("newsletter_subscribers")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model ArticleNote {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_notes")
}

model ArticleCorrection {
  id            String   @id @default(uuid())
  articleId     String   @map("article_id")
  description   String
  correctedAt   DateTime @default(now()) @map("corrected_at")
  correctedById String   @map("corrected_by_id")

  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  correctedBy User    @relation(fields: [correctedById], references: [id])

  @@index([articleId, correctedAt])
  @@map("article_corrections")
}

/// One row per meaningful editorial action on an article (workflow transitions, published-article
/// edits, corrections). Answers "who did what, to which article, when" for newsroom governance —
/// deliberately does not store full article bodies, only a short human-readable note.
model ArticleAuditLog {
  id         String   @id @default(uuid())
  articleId  String   @map("article_id")
  actorId    String?  @map("actor_id")
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_audit_logs")
}

/// Admin-controlled live breaking-news ticker (Phase 2L) — deliberately separate from Article's own
/// isBreaking/breakingPriority/breakingEndsAt flags (Phase 2H), which mark an article itself as
/// breaking for homepage/hero placement. This model is the ticker bar's own content: a headline with
/// full appearance control, optionally but not necessarily linked to an article, so the newsroom can
/// run a breaking item (e.g. a live/developing story with no article yet) without being forced to
/// create one. Article's own breaking flags are untouched by this feature.
model BreakingNews {
  id        String  @id @default(uuid())
  headline  String
  articleId String? @map("article_id")

  isActive Boolean @default(false) @map("is_active")
  /// Ascending sort order for the public ticker — 1 is shown first.
  priority Int     @default(0)
  startAt  DateTime? @map("start_at")
  endAt    DateTime? @map("end_at")

  /// 'SOLID' | 'GRADIENT'
  backgroundMode    String  @default("SOLID") @map("background_mode")
  backgroundColor   String  @default("#D32F2F") @map("background_color")
  gradientStart     String? @map("gradient_start")
  gradientEnd       String? @map("gradient_end")
  /// 'LEFT_RIGHT' | 'RIGHT_LEFT' | 'TOP_BOTTOM' | 'BOTTOM_TOP' | 'DIAGONAL'
  gradientDirection String? @map("gradient_direction")
  textColor             String @default("#FFFFFF") @map("text_color")
  badgeBackgroundColor  String @default("#FFFFFF") @map("badge_background_color")
  badgeTextColor        String @default("#D32F2F") @map("badge_text_color")
  /// Full ticker-cycle duration in milliseconds — admin-tunable animation speed.
  animationSpeedMs Int @default(18000) @map("animation_speed_ms")

  createdById String? @map("created_by_id")
  updatedById String? @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  // SetNull, not Cascade: if the linked article is ever hard-deleted, the ticker item survives as a
  // plain (now unlinked) headline rather than disappearing or leaving a dangling reference.
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("BreakingNewsCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("BreakingNewsUpdatedBy", fields: [updatedById], references: [id])
  auditLogs BreakingNewsAuditLog[]

  // Serves the public ticker's own query (active items due to show, in order) and the admin table.
  @@index([isActive, archivedAt, priority])
  @@index([startAt, endAt])
  @@index([articleId])
  @@map("breaking_news")
}

/// Same append-only "who did what, when" pattern as ArticleAuditLog, kept as its own table rather than
/// reusing ArticleAuditLog because that table's articleId column is required — most breaking-news
/// actions (activate/deactivate/reorder/color changes) aren't about any one article.
model BreakingNewsAuditLog {
  id             String   @id @default(uuid())
  breakingNewsId String   @map("breaking_news_id")
  actorId        String?  @map("actor_id")
  action         String
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  breakingNews BreakingNews @relation(fields: [breakingNewsId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([breakingNewsId, createdAt])
  @@map("breaking_news_audit_logs")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("platform_settings")
}

// ==================== PHASE 5 MODELS ====================

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
  DELETED
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum AdType {
  BANNER
  IMAGE
  HTML
}

enum AdSlotName {
  HEADER_TOP
  HEADER_BOTTOM
  HOME_HERO_BELOW
  HOME_FEED
  ARTICLE_TOP
  ARTICLE_MIDDLE
  ARTICLE_BOTTOM
  CATEGORY_TOP
  SIDEBAR
  FOOTER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Comment {
  id            String        @id @default(uuid())
  articleId     String        @map("article_id")
  userId        String?       @map("user_id")
  guestName     String?       @map("guest_name")
  parentId      String?       @map("parent_id")
  content       String
  status        CommentStatus @default(PENDING)
  moderatedAt   DateTime?     @map("moderated_at")
  moderatedById String?       @map("moderated_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  article     Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User?           @relation("CommentAuthor", fields: [userId], references: [id])
  parent      Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]       @relation("CommentReplies")
  moderatedBy User?           @relation("CommentModerator", fields: [moderatedById], references: [id])
  reports     CommentReport[]

  @@index([articleId])
  @@index([status])
  @@index([createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

model CommentReport {
  id         String       @id @default(uuid())
  commentId  String       @map("comment_id")
  reason     String
  reportedBy String?      @map("reported_by")
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([status])
  @@map("comment_reports")
}

model Ad {
  id           String     @id @default(uuid())
  name         String
  type         AdType
  status       AdStatus   @default(DRAFT)
  mediaId      String?    @map("media_id")
  targetUrl    String?    @map("target_url")
  htmlContent  String?    @map("html_content")
  slot         AdSlotName
  priority     Int        @default(0)
  startAt      DateTime?  @map("start_at")
  endAt        DateTime?  @map("end_at")
  deviceTarget String     @default("all") @map("device_target")
  pageTarget   String?    @map("page_target")
  categoryId   String?    @map("category_id")
  locationId   String?    @map("location_id")
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  createdBy   User           @relation(fields: [createdById], references: [id])
  media       Media?         @relation(fields: [mediaId], references: [id])
  impressions AdImpression[]
  clicks      AdClick[]

  @@index([status])
  @@index([slot])
  @@index([startAt])
  @@index([endAt])
  @@index([status, slot])
  @@map("ads")
}

model AdImpression {
  id        String   @id @default(uuid())
  adId      String   @map("ad_id")
  slot      String
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([createdAt])
  @@index([adId, createdAt])
  @@map("ad_impressions")
}

model AdClick {
  id        String   @id @default(uuid())
  adId      String   @map("ad_id")
  slot      String
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([createdAt])
  @@index([adId, createdAt])
  @@map("ad_clicks")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String   @map("event_type")
  articleId  String?  @map("article_id")
  categoryId String?  @map("category_id")
  locationId String?  @map("location_id")
  adId       String?  @map("ad_id")
  sessionId  String?  @map("session_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([createdAt])
  @@index([articleId])
  @@index([categoryId])
  @@index([locationId])
  @@index([adId])
  @@index([eventType, createdAt])
  @@map("analytics_events")
}

// ==================== JOBS PLATFORM (Phase 2O) ====================

/// Job taxonomy, kept as its own small model rather than reusing the news `Category` tree: job
/// categories (Government, Bank, IT & Software, ...) are a fundamentally different, flatter list than
/// news sections, and keeping them separate means neither taxonomy's admin UI/queries have to filter
/// the other out.
model JobCategory {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  status      JobCategoryStatus @default(ACTIVE)
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  jobs Job[]

  @@index([slug])
  @@index([status])
  @@map("job_categories")
}

/// Employer/company foundation for Phase 2O — admin-managed only (no self-service login/dashboard yet;
/// that is Phase 2P). Deliberately shaped like ReaderProfile (1:1-with-User avatar/logo pattern) so a
/// real employer login can be layered on in Phase 2P by adding a nullable `userId` here rather than
/// redesigning the model.
model Employer {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  logoMediaId  String?        @map("logo_media_id")
  website      String?
  description  String?
  industry     String?
  locationId   String?        @map("location_id")
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  status       EmployerStatus @default(ACTIVE)
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  logo      Media?    @relation("EmployerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  location  Location? @relation(fields: [locationId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])
  jobs      Job[]

  @@index([slug])
  @@index([status])
  @@index([logoMediaId])
  @@map("employers")
}

/// Mirrors Article's shape closely (Json rich-text fields, the same DRAFT→...→PUBLISHED→ARCHIVED
/// workflow idea via JobStatus, the same createdBy/updatedBy audit pair) but is intentionally its own
/// model rather than an Article subtype — a job posting has no author/byline concept and instead has
/// employer/salary/deadline/application fields Article has no use for.
model Job {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  summary      String?
  description  Json?
  responsibilities Json?
  requirements Json?
  qualifications   Json?
  experience   String?

  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  salaryCurrency   String?  @default("BDT") @map("salary_currency")
  salaryNegotiable Boolean  @default(false) @map("salary_negotiable")

  employmentType EmploymentType @map("employment_type")
  workplaceType  WorkplaceType @default(ON_SITE) @map("workplace_type")
  vacancies      Int?          @default(1)

  categoryId String  @map("category_id")
  employerId String  @map("employer_id")
  locationId String? @map("location_id")

  applicationMethod       ApplicationMethod @default(INTERNAL) @map("application_method")
  externalApplyUrl        String?           @map("external_apply_url")
  applicationEmail        String?           @map("application_email")
  applicationInstructions String?           @map("application_instructions")

  featured    Boolean   @default(false)
  status      JobStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at")
  scheduledAt DateTime? @map("scheduled_at")
  deadline    DateTime?
  viewCount   Int       @default(0) @map("view_count")

  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category     JobCategory      @relation(fields: [categoryId], references: [id])
  employer     Employer         @relation(fields: [employerId], references: [id])
  location     Location?        @relation(fields: [locationId], references: [id])
  createdBy    User             @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?            @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  applications JobApplication[]
  savedBy      SavedJob[]
  auditLogs    JobAuditLog[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([employerId])
  @@index([locationId])
  @@index([status, publishedAt])
  @@index([featured])
  @@index([deadline])
  @@map("jobs")
}

/// Same append-only audit pattern as ArticleAuditLog (see that model for the full rationale) — one
/// table, free-text `action`/fromStatus/toStatus rather than a closed enum, so new workflow actions
/// never require a migration.
model JobAuditLog {
  id         String   @id @default(uuid())
  jobId      String   @map("job_id")
  actorId    String?  @map("actor_id")
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([jobId, createdAt])
  @@map("job_audit_logs")
}

/// Mirrors Bookmark exactly (see that model) — `@@unique([userId, jobId])` is what makes "save" an
/// idempotent upsert instead of needing an application-level duplicate check.
model SavedJob {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
  @@map("saved_jobs")
}

/// Deliberately its own small model rather than reusing Media: a resume is applicant-owned, private
/// (never listed in the admin Media library, never referenced by public pages) and not necessarily an
/// image, so Media's magic-byte image-signature validation doesn't apply. `isDefault` lets a user keep
/// several resumes and pick which one a new application uses without deleting the others.
model Resume {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  fileName   String   @map("file_name")
  storageKey String   @unique @map("storage_key")
  publicUrl  String   @map("public_url")
  mimeType   String   @map("mime_type")
  size       Int
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([userId])
  @@map("resumes")
}

/// Only ever created for `Job.applicationMethod == INTERNAL` — an EXTERNAL_URL/EMAIL job sends the
/// candidate off-platform instead and no row is created here (see ApplicationMethod). `notes` is an
/// admin-only internal field, never serialized to the applicant-facing API.
model JobApplication {
  id           String            @id @default(uuid())
  jobId        String            @map("job_id")
  applicantId  String            @map("applicant_id")
  resumeId     String?           @map("resume_id")
  coverLetter  String?           @map("cover_letter")
  status       ApplicationStatus @default(SUBMITTED)
  method       ApplicationMethod @default(INTERNAL)
  notes        String?
  reviewedById String?           @map("reviewed_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant  User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resume     Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@unique([jobId, applicantId])
  @@index([applicantId, createdAt])
  @@index([jobId, status])
  @@index([status])
  @@map("job_applications")
}
