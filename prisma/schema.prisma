generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum AccountType {
  STAFF
  READER
}

enum CollectionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  BREAKING_NEWS
  NEW_ARTICLE
  RECOMMENDATION
  SYSTEM
  JOB_ALERT
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum HomepageSectionType {
  HERO
  LATEST
  BANGLADESH
  WORLD
  POLITICS
  BUSINESS
  SPORTS
  TECHNOLOGY
  ENTERTAINMENT
  TRENDING
  MOST_READ
  CUSTOM
}

enum HomepageConfigurationStatus {
  ACTIVE
  DRAFT
}

/// Where a homepage section gets its stories from.
/// MANUAL uses the section's HomepagePlacement rows (editor-picked, ordered).
/// Every other value is resolved automatically at read time from published articles.
enum HomepageSourceType {
  MANUAL
  LATEST
  CATEGORY
  TAG
  LOCATION
}

// SAFETY: shadowDatabaseUrl MUST point at a separate, disposable database — never DATABASE_URL. Prisma
// resets whatever database this URL points to when computing a migration diff. See
// docs/DATABASE-SAFETY.md. If SHADOW_DATABASE_URL is unset, Prisma falls back to creating/dropping a
// temporary database on the same server automatically for local dev; it must still never be set to a
// production connection string.
datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR_IN_CHIEF
  EDITOR
  REPORTER
  PHOTOGRAPHER
  CONTRIBUTOR
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Bangladesh keeps its exact original levels (COUNTRY/DIVISION/DISTRICT/UPAZILA). The rest support a
/// global hierarchy without forcing every country into that same shape — a location's real parent chain
/// (via parentId) is what matters; `type` is a label, not a fixed depth.
enum LocationType {
  CONTINENT
  COUNTRY
  STATE
  PROVINCE
  REGION
  DIVISION
  DISTRICT
  COUNTY
  CITY
  MUNICIPALITY
  UPAZILA
  SUBDISTRICT
  OTHER
}

/// bn is the platform default; en is the second supported language. Admin-managed via the Languages
/// module — enable/disable and default are data (isActive/isDefault), never hardcoded in code.
model Language {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  nativeName String   @map("native_name")
  direction  String   @default("ltr")
  isActive   Boolean  @default(true) @map("is_active")
  isDefault  Boolean  @default(false) @map("is_default")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  articles             Article[]
  categoryTranslations CategoryTranslation[]
  tagTranslations      TagTranslation[]
  locationTranslations LocationTranslation[]
  adCampaigns          AdCampaign[]

  @@map("languages")
}

/// One localized name per (location, language). The base Location.name/slug stay the canonical
/// administrative identity; a translation only changes what is displayed.
model LocationTranslation {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  languageId String   @map("language_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([locationId, languageId])
  @@map("location_translations")
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum TagStatus {
  ACTIVE
  INACTIVE
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

/// Job posting workflow (Phase 2O) — mirrors ArticleStatus's DRAFT→IN_REVIEW→APPROVED→PUBLISHED→
/// ARCHIVED shape with two job-specific additions: SCHEDULED (a job approved for a future publishAt,
/// same idea as Article's own scheduling) and EXPIRED (deadline passed while still PUBLISHED — a
/// distinct state from ARCHIVED, which is an admin's deliberate takedown).
enum JobStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum JobCategoryStatus {
  ACTIVE
  INACTIVE
}

enum EmployerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Phase 2P: separate from EmployerStatus (account-level active/inactive/suspended) — this tracks
/// whether Admin has confirmed the company is a real, legitimate organization. An unverified employer
/// can still use the dashboard/drafts, but published jobs remain gated by the normal job.publish
/// permission regardless of verification, so this never becomes a second bypass path.
enum EmployerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Company-team roles for self-service employer accounts (Phase 2P) — deliberately its own small
/// enum/model rather than reusing the platform Role/Permission system: an employer's "ADMIN" must never
/// be confused with a platform Admin, and giving every company its own Role rows would pollute the
/// global RBAC tables. See EmployerMembership.
enum EmployerMembershipRole {
  OWNER
  ADMIN
  RECRUITER
}

/// Lifecycle of a single EmployerMembership row. INVITED = created by an OWNER/ADMIN but not yet
/// accepted by the invited user; ACTIVE = accepted and usable to authorize employer-portal actions;
/// SUSPENDED = temporarily blocked (reserved for future use, not yet set by any endpoint in this phase);
/// REMOVED = soft-deleted, kept for audit history instead of a hard delete.
enum EmployerMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum JobPostingPlanType {
  FREE
  PAID
}

/// Mirrors the shape any future real gateway integration (bKash/Nagad/card) will need — an order is
/// never marked SUCCEEDED by this codebase itself (Phase 2P ships no live gateway), only PENDING/
/// FAILED/CANCELLED are reachable without manual, permissioned intervention. See JobPostingOrder.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

/// How a candidate actually applies. INTERNAL means the application form lives on this platform and
/// produces a JobApplication row; EXTERNAL_URL/EMAIL mean the "Apply Now" action sends the candidate
/// off-platform (an employer's own site, or a plain mailto:) and no JobApplication row is created.
enum ApplicationMethod {
  INTERNAL
  EXTERNAL_URL
  EMAIL
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  ACCEPTED
  WITHDRAWN
}

// ==================== MODELS ====================

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles               UserRoleAssignment[]
  authoredArticles        Article[]                  @relation("ArticleAuthor")
  reviewedArticles        Article[]                  @relation("ArticleReviewer")
  assignedArticles        Article[]                  @relation("ArticleAssignee")
  createdBreakingNews     BreakingNews[]              @relation("BreakingNewsCreatedBy")
  updatedBreakingNews     BreakingNews[]              @relation("BreakingNewsUpdatedBy")
  breakingNewsAuditLogs   BreakingNewsAuditLog[]
  sessions                Session[]
  uploadedMedia           Media[]
  revisedArticles         ArticleRevision[]
  comments                Comment[]                  @relation("CommentAuthor")
  moderatedComments       Comment[]                  @relation("CommentModerator")
  createdAds              Ad[]
  accountType             AccountType                @default(STAFF) @map("account_type")
  verifiedAt              DateTime?                  @map("verified_at")
  readerProfile           ReaderProfile?
  bookmarks               Bookmark[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  createdCollections      EditorialCollection[]
  articleNotes            ArticleNote[]
  corrections             ArticleCorrection[]
  auditLogEntries         ArticleAuditLog[]
  preferenceCategories    ReaderPreferenceCategory[]
  preferenceLocations     ReaderPreferenceLocation[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // Jobs platform (Phase 2O)
  createdJobs        Job[]             @relation("JobCreatedBy")
  updatedJobs        Job[]             @relation("JobUpdatedBy")
  jobAuditLogEntries JobAuditLog[]
  savedJobs          SavedJob[]
  resumes            Resume[]
  jobApplications    JobApplication[]
  reviewedApplications JobApplication[] @relation("ApplicationReviewer")
  createdEmployers   Employer[]
  verifiedEmployers    Employer[]           @relation("EmployerVerifiedBy")
  employerMemberships  EmployerMembership[]
  invitedEmployerMemberships EmployerMembership[] @relation("EmployerMembershipInvitedBy")
  createdJobPostingOrders JobPostingOrder[]
  employerAuditLogEntries EmployerAuditLog[]

  // Advertisement platform (Phase 2Q)
  createdAdvertisers    Advertiser[]
  createdAdCampaigns    AdCampaign[] @relation("AdCampaignCreatedBy")
  approvedAdCampaigns   AdCampaign[] @relation("AdCampaignApprovedBy")
  adAuditLogEntries     AdAuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions     RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model Location {
  id          String         @id @default(uuid())
  name        String
  slug        String
  type        LocationType
  parentId    String?        @map("parent_id")
  identityKey String         @unique @map("identity_key")
  status      LocationStatus @default(ACTIVE)
  /// ISO 3166-1 alpha-2, set on COUNTRY rows (and useful on CONTINENT/STATE rows for filtering).
  countryCode String?        @map("country_code")
  latitude    Float?
  longitude   Float?
  timezone    String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  parent            Location?                  @relation("LocationTree", fields: [parentId], references: [id])
  children          Location[]                 @relation("LocationTree")
  articles          Article[]
  readerPreferences ReaderPreferenceLocation[]
  homepageSections  HomepageSection[]
  translations      LocationTranslation[]
  jobs              Job[]
  employers         Employer[]
  adCampaigns       AdCampaign[]

  @@unique([type, parentId, slug])
  @@index([slug])
  @@index([parentId])
  @@index([status])
  @@index([countryCode])
  @@map("locations")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  parentId    String?        @map("parent_id")
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  parent            Category?                  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]                 @relation("CategoryTree")
  articles          Article[]
  readerPreferences ReaderPreferenceCategory[]
  homepageSections  HomepageSection[]
  translations      CategoryTranslation[]
  adCampaigns       AdCampaign[]

  @@index([slug])
  @@index([status])
  @@map("categories")
}

/// Localized display name (and, for URL consistency, a per-language slug — defaults to the base slug
/// so /category/:slug stays language-agnostic unless an editor deliberately gives a language its own URL).
model CategoryTranslation {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  languageId  String   @map("language_id")
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageId])
  @@unique([languageId, slug])
  @@map("category_translations")
}

model Tag {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    TagStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  articleTags      ArticleTag[]
  homepageSections HomepageSection[]
  translations     TagTranslation[]

  @@index([slug])
  @@map("tags")
}

/// One tag, many localized names/slugs — never two unrelated tags for the same concept.
model TagTranslation {
  id         String   @id @default(uuid())
  tagId      String   @map("tag_id")
  languageId String   @map("language_id")
  name       String
  slug       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageId])
  @@unique([languageId, slug])
  @@map("tag_translations")
}

/// Groups Article rows that are translations of one another. A source article gets one of these the
/// moment its first translation is created; a standalone article (no group) has no known translations.
model ArticleTranslationGroup {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  articles Article[]

  @@map("article_translation_groups")
}

model Article {
  id                 String        @id @default(uuid())
  title              String
  slug               String        @unique
  excerpt            String?
  content            Json?
  seoTitle           String?       @map("seo_title")
  seoDescription     String?       @map("seo_description")
  seoKeywords        String?       @map("seo_keywords")
  canonicalUrl       String?       @map("canonical_url")
  noIndex            Boolean       @default(false) @map("no_index")
  status             ArticleStatus @default(DRAFT)
  authorId           String        @map("author_id")
  categoryId         String?       @map("category_id")
  featuredImageId    String?       @map("featured_image_id")
  locationId         String?       @map("location_id")
  /// Nullable only for rows that predate Phase 2C; every public read treats null as the default language.
  languageId         String?       @map("language_id")
  /// Set once this article has at least one translation; shared by every language version of the same story.
  translationGroupId String?       @map("translation_group_id")
  publishedAt        DateTime?     @map("published_at")
  reviewedAt         DateTime?     @map("reviewed_at")
  reviewedById       String?       @map("reviewed_by_id")
  archivedAt         DateTime?     @map("archived_at")
  // Breaking news fields
  isBreaking         Boolean?      @default(false) @map("is_breaking")
  breakingStartedAt  DateTime?     @map("breaking_started_at")
  breakingEndsAt     DateTime?     @map("breaking_ends_at")
  breakingPriority   Int?          @map("breaking_priority")
  // Scheduling fields
  scheduledAt        DateTime?     @map("scheduled_at")
  // Assignment fields (Phase 2L) — who is currently responsible for moving this article forward,
  // separate from authorship: an editor can assign a story to a reporter/writer without changing who
  // wrote it, and reassignment is just calling assign() again (no history kept beyond the audit log).
  assigneeId         String?       @map("assignee_id")
  assignedAt         DateTime?     @map("assigned_at")
  assignmentNote     String?       @map("assignment_note")
  // View tracking
  viewCount          Int           @default(0) @map("view_count")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  author             User                     @relation("ArticleAuthor", fields: [authorId], references: [id])
  assignee           User?                    @relation("ArticleAssignee", fields: [assigneeId], references: [id])
  category           Category?                @relation(fields: [categoryId], references: [id])
  location           Location?                @relation(fields: [locationId], references: [id])
  media              Media?                   @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id])
  reviewedBy         User?                    @relation("ArticleReviewer", fields: [reviewedById], references: [id])
  language           Language?                @relation(fields: [languageId], references: [id])
  translationGroup   ArticleTranslationGroup? @relation(fields: [translationGroupId], references: [id])
  articleTags        ArticleTag[]
  views              ArticleView[]
  revisions          ArticleRevision[]
  comments           Comment[]
  bookmarks          Bookmark[]
  collectionItems    ArticleCollection[]
  notes              ArticleNote[]
  corrections        ArticleCorrection[]
  auditLogs          ArticleAuditLog[]
  notifications      Notification[]
  homepagePlacements HomepagePlacement[]
  breakingNewsItems  BreakingNews[]
  manualRelated      ArticleRelated[] @relation("RelatedSource")
  manuallyRelatedTo  ArticleRelated[] @relation("RelatedTarget")

  @@unique([translationGroupId, languageId])
  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([locationId])
  @@index([featuredImageId])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([isBreaking])
  @@index([breakingPriority])
  @@index([scheduledAt])
  @@index([assigneeId])
  @@index([status, publishedAt])
  @@index([status, isBreaking])
  @@index([languageId])
  @@index([translationGroupId])
  @@map("articles")
}

/// Editor-curated related stories. Automatic recommendations remain computed at read time and fill
/// any remaining slots after these ordered rows.
model ArticleRelated {
  articleId        String   @map("article_id")
  relatedArticleId String   @map("related_article_id")
  position         Int
  createdAt        DateTime @default(now()) @map("created_at")

  article        Article @relation("RelatedSource", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle Article @relation("RelatedTarget", fields: [relatedArticleId], references: [id], onDelete: Cascade)

  @@id([articleId, relatedArticleId])
  @@unique([articleId, position])
  @@index([relatedArticleId])
  @@map("article_related")
}

model ArticleView {
  id          String   @id @default(uuid())
  articleId   String   @map("article_id")
  sessionId   String?  @map("session_id")
  fingerprint String?  @map("fingerprint")
  viewedAt    DateTime @default(now()) @map("viewed_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([viewedAt])
  @@index([articleId, viewedAt])
  @@index([fingerprint])
  @@map("article_views")
}

model ArticleRevision {
  id              String   @id @default(uuid())
  articleId       String   @map("article_id")
  version         Int
  title           String
  excerpt         String?
  content         Json?
  slug            String
  categoryId      String?  @map("category_id")
  locationId      String?  @map("location_id")
  featuredImageId String?  @map("featured_image_id")
  authorId        String   @map("author_id")
  status          String
  changedById     String   @map("changed_by_id")
  changeReason    String?  @map("change_reason")
  createdAt       DateTime @default(now()) @map("created_at")

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@unique([articleId, version])
  @@index([articleId])
  @@index([changedById])
  @@index([createdAt])
  @@map("article_revisions")
}

model ArticleTag {
  articleId String   @map("article_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("article_tags")
}

/// Phase 2R. UPLOADING = a presigned-upload Media row created before the browser has actually pushed
/// bytes to storage (see MediaService.createPresignedUpload) — never publicly served or picker-selectable
/// until verified. READY = the direct-upload path's terminal state immediately, or what UPLOADING becomes
/// once /media/:id/complete verifies the object really exists in storage. FAILED = complete() couldn't
/// find the object (abandoned/broken client upload). DELETED = soft-delete marker for the orphan-cleanup
/// foundation (see MediaService.markOrphanCandidate) — existing hard-delete-when-unreferenced behavior in
/// MediaService.remove() is unchanged; this status is for a *future* cleanup job, not created by it yet.
enum MediaStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

/// Which StorageProvider actually holds the object — informational (which backend to expect) rather than
/// load-bearing: the provider that serves a request is always today's STORAGE_PROVIDER/MEDIA_STORAGE_PROVIDER
/// config, so this can't silently point requests at a provider no longer configured.
enum MediaProvider {
  LOCAL
  R2
}

model Media {
  id               String   @id @default(uuid())
  filename         String
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  size             Int
  width            Int?
  height           Int?
  storageKey       String   @unique @map("storage_key")
  publicUrl        String   @map("public_url")
  altText          String?  @map("alt_text")
  caption          String?
  credit           String?
  uploadedById     String   @map("uploaded_by_id")

  /// Existing rows (pre-Phase 2R, all direct-uploaded) default to READY/LOCAL — both are accurate for
  /// every row that already exists, since the direct-upload path never had a pending state and this
  /// project's storage has only ever run as `local` so far.
  status           MediaStatus   @default(READY)
  provider         MediaProvider @default(LOCAL)
  bucket           String?
  /// Set only on a presigned-upload row while it's UPLOADING — lets the orphan-detection foundation flag
  /// a row whose browser upload never arrived (see MediaService.findOrphanCandidates).
  uploadExpiresAt  DateTime?     @map("upload_expires_at")
  /// Soft-delete marker for the orphan-cleanup foundation (Step 24) — set by markOrphanCandidate(), never
  /// by remove() today. A future cleanup job decides what to do with DELETED+deletedAt-set rows.
  deletedAt        DateTime?     @map("deleted_at")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  uploadedBy       User                  @relation(fields: [uploadedById], references: [id])
  featuredArticles Article[]             @relation("ArticleFeaturedImage")
  ads              Ad[]
  collectionCovers EditorialCollection[]
  adCreativeDesktopFor AdCreative[]      @relation("AdCreativeDesktopMedia")
  adCreativeMobileFor  AdCreative[]      @relation("AdCreativeMobileMedia")
  readerAvatars    ReaderProfile[]       @relation("ReaderAvatar")
  employerLogos    Employer[]            @relation("EmployerLogo")
  employerCovers   Employer[]            @relation("EmployerCover")

  @@index([uploadedById])
  @@index([status])
  @@index([mimeType])
  @@index([createdAt])
}

model ReaderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  displayName       String
  preferredLanguage String   @default("en") @map("preferred_language")
  avatarMediaId     String?  @map("avatar_media_id")
  phone             String?
  bio               String?
  location          String?
  theme             String   @default("SYSTEM")
  profilePublic     Boolean  @default(false) @map("profile_public")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar Media? @relation("ReaderAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([avatarMediaId])

  @@map("reader_profiles")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId, createdAt])
  @@index([articleId])
  @@map("bookmarks")
}

model ReaderPreferenceCategory {
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

