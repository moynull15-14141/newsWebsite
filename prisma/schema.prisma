model ArticleCollection {
  articleId    String   @map("article_id")
  collectionId String   @map("collection_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  article    Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  collection EditorialCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([articleId, collectionId])
  @@index([collectionId, sortOrder])
  @@map("article_collections")
}

/// A section belongs to exactly one HomepageConfiguration (the live ACTIVE one or the editable DRAFT).
/// `key` is the stable identity inside a configuration and is shared by the ACTIVE and DRAFT copy of
/// the same section: lower(type) for singleton types, custom-<suffix> for repeatable CUSTOM sections.
/// `layoutType` holds a validated preset (FEATURED_STACK | THREE_UP | COMPACT_LIST), enforced by the service.
model HomepageSection {
  id              String              @id @default(uuid())
  configurationId String              @map("configuration_id")
  type            HomepageSectionType
  key             String
  title           String
  enabled         Boolean             @default(true)
  sortOrder       Int                 @default(0) @map("sort_order")
  sourceType      HomepageSourceType  @default(MANUAL) @map("source_type")
  categoryId      String?             @map("category_id")
  locationId      String?             @map("location_id")
  tagId           String?             @map("tag_id")
  maxItems        Int                 @default(4) @map("max_items")
  layoutType      String              @default("FEATURED_STACK") @map("layout_type")
  /// Presentation override: "AUTO" lets the layout choose the NewsCard variant.
  cardVariant     String              @default("AUTO") @map("card_variant")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  configuration HomepageConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [categoryId], references: [id])
  location      Location?             @relation(fields: [locationId], references: [id])
  tag           Tag?                  @relation(fields: [tagId], references: [id])
  placements    HomepagePlacement[]

  @@unique([configurationId, key])
  @@index([enabled, sortOrder])
  @@index([configurationId, sortOrder])
  @@index([tagId])
  @@map("homepage_sections")
}

/// Homepage configuration boundary. INVARIANT: at most one row per status (unique index on `status`),
/// so "which homepage is live?" is always the single ACTIVE row. The DRAFT row is the persistent
/// single working copy; `version` is bumped on every draft mutation (optimistic concurrency) and on
/// every publish of the ACTIVE row. Publishing copies DRAFT -> ACTIVE inside one transaction.
model HomepageConfiguration {
  id          String                      @id @default(uuid())
  status      HomepageConfigurationStatus @unique
  version     Int                         @default(1)
  publishedAt DateTime?                   @map("published_at")
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  sections HomepageSection[]

  @@map("homepage_configurations")
}

model HomepagePlacement {
  sectionId String @map("section_id")
  articleId String @map("article_id")
  sortOrder Int    @default(0) @map("sort_order")

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  article Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([sectionId, articleId])
  @@index([sectionId, sortOrder])
  @@map("homepage_placements")
}

model NewsletterSubscriber {
  id             String           @id @default(uuid())
  email          String           @unique
  status         SubscriberStatus @default(PENDING)
  subscribedAt   DateTime         @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime?        @map("unsubscribed_at")
  verifiedAt     DateTime?        @map("verified_at")

  @@index([status])
  @@map("newsletter_subscribers")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model ArticleNote {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_notes")
}

model ArticleCorrection {
  id            String   @id @default(uuid())
  articleId     String   @map("article_id")
  description   String
  correctedAt   DateTime @default(now()) @map("corrected_at")
  correctedById String   @map("corrected_by_id")

  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  correctedBy User    @relation(fields: [correctedById], references: [id])

  @@index([articleId, correctedAt])
  @@map("article_corrections")
}

/// One row per meaningful editorial action on an article (workflow transitions, published-article
/// edits, corrections). Answers "who did what, to which article, when" for newsroom governance —
/// deliberately does not store full article bodies, only a short human-readable note.
model ArticleAuditLog {
  id         String   @id @default(uuid())
  articleId  String   @map("article_id")
  actorId    String?  @map("actor_id")
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([articleId, createdAt])
  @@map("article_audit_logs")
}

/// Admin-controlled live breaking-news ticker (Phase 2L) — deliberately separate from Article's own
/// isBreaking/breakingPriority/breakingEndsAt flags (Phase 2H), which mark an article itself as
/// breaking for homepage/hero placement. This model is the ticker bar's own content: a headline with
/// full appearance control, optionally but not necessarily linked to an article, so the newsroom can
/// run a breaking item (e.g. a live/developing story with no article yet) without being forced to
/// create one. Article's own breaking flags are untouched by this feature.
model BreakingNews {
  id        String  @id @default(uuid())
  headline  String
  articleId String? @map("article_id")

  isActive Boolean @default(false) @map("is_active")
  /// Ascending sort order for the public ticker — 1 is shown first.
  priority Int     @default(0)
  startAt  DateTime? @map("start_at")
  endAt    DateTime? @map("end_at")

  /// 'SOLID' | 'GRADIENT'
  backgroundMode    String  @default("SOLID") @map("background_mode")
  backgroundColor   String  @default("#D32F2F") @map("background_color")
  gradientStart     String? @map("gradient_start")
  gradientEnd       String? @map("gradient_end")
  /// 'LEFT_RIGHT' | 'RIGHT_LEFT' | 'TOP_BOTTOM' | 'BOTTOM_TOP' | 'DIAGONAL'
  gradientDirection String? @map("gradient_direction")
  textColor             String @default("#FFFFFF") @map("text_color")
  badgeBackgroundColor  String @default("#FFFFFF") @map("badge_background_color")
  badgeTextColor        String @default("#D32F2F") @map("badge_text_color")
  /// Full ticker-cycle duration in milliseconds — admin-tunable animation speed.
  animationSpeedMs Int @default(18000) @map("animation_speed_ms")

  createdById String? @map("created_by_id")
  updatedById String? @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  // SetNull, not Cascade: if the linked article is ever hard-deleted, the ticker item survives as a
  // plain (now unlinked) headline rather than disappearing or leaving a dangling reference.
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("BreakingNewsCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("BreakingNewsUpdatedBy", fields: [updatedById], references: [id])
  auditLogs BreakingNewsAuditLog[]

  // Serves the public ticker's own query (active items due to show, in order) and the admin table.
  @@index([isActive, archivedAt, priority])
  @@index([startAt, endAt])
  @@index([articleId])
  @@map("breaking_news")
}

/// Same append-only "who did what, when" pattern as ArticleAuditLog, kept as its own table rather than
/// reusing ArticleAuditLog because that table's articleId column is required — most breaking-news
/// actions (activate/deactivate/reorder/color changes) aren't about any one article.
model BreakingNewsAuditLog {
  id             String   @id @default(uuid())
  breakingNewsId String   @map("breaking_news_id")
  actorId        String?  @map("actor_id")
  action         String
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  breakingNews BreakingNews @relation(fields: [breakingNewsId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([breakingNewsId, createdAt])
  @@map("breaking_news_audit_logs")
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("platform_settings")
}

// ==================== PHASE 5 MODELS ====================

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
  DELETED
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum AdType {
  BANNER
  IMAGE
  HTML
}

enum AdSlotName {
  HEADER_TOP
  HEADER_BOTTOM
  HOME_HERO_BELOW
  HOME_FEED
  ARTICLE_TOP
  ARTICLE_MIDDLE
  ARTICLE_BOTTOM
  CATEGORY_TOP
  SIDEBAR
  FOOTER
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Comment {
  id            String        @id @default(uuid())
  articleId     String        @map("article_id")
  userId        String?       @map("user_id")
  guestName     String?       @map("guest_name")
  parentId      String?       @map("parent_id")
  content       String
  status        CommentStatus @default(PENDING)
  moderatedAt   DateTime?     @map("moderated_at")
  moderatedById String?       @map("moderated_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  article     Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User?           @relation("CommentAuthor", fields: [userId], references: [id])
  parent      Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]       @relation("CommentReplies")
  moderatedBy User?           @relation("CommentModerator", fields: [moderatedById], references: [id])
  reports     CommentReport[]

  @@index([articleId])
  @@index([status])
  @@index([createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

model CommentReport {
  id         String       @id @default(uuid())
  commentId  String       @map("comment_id")
  reason     String
  reportedBy String?      @map("reported_by")
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@index([status])
  @@map("comment_reports")
}

model Ad {
  id           String     @id @default(uuid())
  name         String
  type         AdType
  status       AdStatus   @default(DRAFT)
  mediaId      String?    @map("media_id")
  targetUrl    String?    @map("target_url")
  htmlContent  String?    @map("html_content")
  slot         AdSlotName
  priority     Int        @default(0)
  startAt      DateTime?  @map("start_at")
  endAt        DateTime?  @map("end_at")
  deviceTarget String     @default("all") @map("device_target")
  pageTarget   String?    @map("page_target")
  categoryId   String?    @map("category_id")
  locationId   String?    @map("location_id")
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  createdBy   User           @relation(fields: [createdById], references: [id])
  media       Media?         @relation(fields: [mediaId], references: [id])
  impressions AdImpression[]
  clicks      AdClick[]

  @@index([status])
  @@index([slot])
  @@index([startAt])
  @@index([endAt])
  @@index([status, slot])
  @@map("ads")
}

model AdImpression {
  id        String   @id @default(uuid())
  adId      String   @map("ad_id")
  slot      String
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([createdAt])
  @@index([adId, createdAt])
  @@map("ad_impressions")
}

model AdClick {
  id        String   @id @default(uuid())
  adId      String   @map("ad_id")
  slot      String
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId])
  @@index([createdAt])
  @@index([adId, createdAt])
  @@map("ad_clicks")
}

// ==================== ADVERTISEMENT PLATFORM (Phase 2Q) ====================
// Deliberately separate from the flat Ad/AdImpression/AdClick models above (Phase 2K-era, zero rows in
// any real environment): those models have no Advertiser/Campaign/Creative separation, so they can't
// express "one advertiser runs one campaign across several placements with several rotating creatives
// and a real approval workflow" — the actual business requirement. Rather than shoehorning that onto
// the flat model, this is the real inventory system; the old models are left in place (unused by the
// new admin/public code) rather than dropped, since dropping a table is a destructive migration and
// they hold no data worth migrating.

/// DRAFT -> PENDING_REVIEW -> APPROVED -> (SCHEDULED ->) ACTIVE -> PAUSED/EXPIRED -> ARCHIVED. Mirrors
/// JobStatus's shape deliberately (see that enum) — same reasoning: a small closed set of admin-driven
/// states plus two states a scheduler can reach on its own (SCHEDULED->ACTIVE, ACTIVE->EXPIRED).
/// PENDING_REVIEW/APPROVED gate is mandatory: nothing reaches ACTIVE without passing through APPROVED
/// first (enforced in AdCampaignsService, not just by convention), so "approval required before public
/// display" cannot be bypassed by e.g. jumping straight from DRAFT to SCHEDULED.
enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

/// IMAGE/RESPONSIVE_IMAGE render through the existing Media abstraction (desktop/mobile asset refs);
/// NATIVE_SPONSORED renders as an in-feed card with its own headline/body and a mandatory "Sponsored"
/// label. VIDEO/HTML_RICH_MEDIA are declared now so PlacementRegistry/CreativeService branches are
/// already exhaustive-checked against them, but no renderer is implemented for either in this phase.
enum AdCreativeType {
  IMAGE
  RESPONSIVE_IMAGE
  NATIVE_SPONSORED
  VIDEO
  HTML_RICH_MEDIA
}

/// The full controlled placement registry (Phase 2Q spec). One AdPlacement row per value, seeded once
/// (see prisma/seed.ts) — never created ad hoc by an admin, so "where can an ad ever appear" stays a
/// reviewable, finite list rather than a free-text slot string (the old AdSlotName's own weakness, kept
/// only for the legacy Ad model above).
enum AdPlacementKey {
  BREAKING_NEWS_BELOW
  TOP_BILLBOARD
  MOBILE_STICKY
  HOME_HERO
  HOME_FEED
  HOME_MID_FEED
  HOME_SIDEBAR
  HOME_BEFORE_FOOTER
  ARTICLE_TOP
  ARTICLE_AFTER_INTRO
  ARTICLE_IN_CONTENT
  ARTICLE_MID
  ARTICLE_END
  ARTICLE_RELATED
  ARTICLE_SIDEBAR
  CATEGORY_TOP
  CATEGORY_FEED
  CATEGORY_MID
  CATEGORY_SIDEBAR
  SEARCH_INLINE
  PAGE_TOP
  PAGE_CONTENT
  PAGE_SIDEBAR
  PAGE_BOTTOM
}

enum AdPlacementGroup {
  GLOBAL
  HOMEPAGE
  ARTICLE
  CATEGORY
  SEARCH
  GENERIC
}

enum AdDeviceTarget {
  ALL
  DESKTOP
  TABLET
  MOBILE
}

/// Coarse page-type targeting — same vocabulary AdPlacementGroup uses for placements, so "this campaign
/// runs on article pages" and "this placement lives on article pages" are the same concept on both
/// sides of the eligibility check (see AdCampaignsService.getEligibleForPlacement).
enum AdPageTarget {
  ALL
  HOMEPAGE
  ARTICLE
  CATEGORY
  SEARCH
  JOBS
  VIDEO
  SPECIAL
}

enum AdEventType {
  IMPRESSION
  CLICK
}

model Advertiser {
  id           String    @id @default(uuid())
  name         String
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  notes        String?
  active       Boolean   @default(true)
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdBy User        @relation(fields: [createdById], references: [id])
  campaigns AdCampaign[]

  @@index([active])
  @@map("advertisers")
}

/// The controlled placement registry itself — one row per AdPlacementKey, seeded once. `enabled` is the
/// site-wide kill switch for a placement (spec: "Admin must be able to enable/disable placement"),
/// independent of any campaign assigned to it — disabling HOME_HERO here hides every campaign from it
/// without touching campaign data, and touches nothing else on the homepage (editorial content is never
/// stored on this table).
model AdPlacement {
  id                 String           @id @default(uuid())
  key                AdPlacementKey   @unique
  label              String
  group              AdPlacementGroup
  description        String?
  recommendedWidth   Int?             @map("recommended_width")
  recommendedHeight  Int?             @map("recommended_height")
  enabled            Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  campaignPlacements AdCampaignPlacement[]
  events             AdEvent[]

  @@map("ad_placements")
}

model AdCampaign {
  id           String           @id @default(uuid())
  name         String
  advertiserId String           @map("advertiser_id")
  status       AdCampaignStatus @default(DRAFT)

  startAt  DateTime? @map("start_at")
  endAt    DateTime? @map("end_at")
  priority Int       @default(0)

  targetUrl String? @map("target_url")

  // Targeting — every field nullable/ALL-default means "no restriction on this dimension". Enforced
  // server-side in AdCampaignsService.getEligibleForPlacement, never left to the client to honor.
  languageId     String?        @map("language_id")
  deviceTarget   AdDeviceTarget @default(ALL) @map("device_target")
  pageTarget     AdPageTarget   @default(ALL) @map("page_target")
  categoryId     String?        @map("category_id")
  locationId     String?        @map("location_id")

  /// Foundation only (spec: "frequency capping foundation") — max times a single session may be served
  /// an impression for this campaign per rolling 24h window. Null = uncapped. Enforced in
  /// AdEventsService.recordImpression the same way the legacy Ad model already deduplicated
  /// same-session impressions, just generalized to a configurable window/count instead of a fixed 30min.
  frequencyCapPerDay Int? @map("frequency_cap_per_day")

  notes String?

  createdById  String    @map("created_by_id")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  advertiser Advertiser            @relation(fields: [advertiserId], references: [id])
  language   Language?             @relation(fields: [languageId], references: [id])
  category   Category?             @relation(fields: [categoryId], references: [id])
  location   Location?             @relation(fields: [locationId], references: [id])
  createdBy  User                  @relation("AdCampaignCreatedBy", fields: [createdById], references: [id])
  approvedBy User?                 @relation("AdCampaignApprovedBy", fields: [approvedById], references: [id])
  creatives  AdCreative[]
  placements AdCampaignPlacement[]
  events     AdEvent[]
  auditLogs  AdAuditLog[]

  @@index([status])
  @@index([advertiserId])
  @@index([startAt])
  @@index([endAt])
  @@index([status, startAt, endAt])
  @@map("ad_campaigns")
}

/// A campaign can have multiple creatives (spec) — e.g. a desktop banner and a square mobile banner for
/// the same offer, or several rotating variants for the same placement. `rotationWeight` feeds a
/// weighted-random pick among a campaign's active creatives at serve time (see AdCampaignsService);
/// equal weights (the default) means even rotation.
model AdCreative {
  id              String         @id @default(uuid())
  campaignId      String         @map("campaign_id")
  type            AdCreativeType

  desktopMediaId  String?        @map("desktop_media_id")
  mobileMediaId   String?        @map("mobile_media_id")
  targetUrl       String?        @map("target_url")
  ctaText         String?        @map("cta_text")
  altText         String?        @map("alt_text")

  /// NATIVE_SPONSORED-only fields. Kept on the same row rather than a separate table: a creative is
  /// always exactly one type for its whole lifetime (no creative switches from IMAGE to NATIVE_SPONSORED),
  /// so a polymorphic side-table would only add a join for no real flexibility gained.
  nativeHeadline     String? @map("native_headline")
  nativeBody         String? @map("native_body")
  nativeSponsorLabel String  @default("Sponsored") @map("native_sponsor_label")

  active         Boolean  @default(true)
  rotationWeight Int      @default(1) @map("rotation_weight")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  desktopMedia Media?     @relation("AdCreativeDesktopMedia", fields: [desktopMediaId], references: [id])
  mobileMedia  Media?     @relation("AdCreativeMobileMedia", fields: [mobileMediaId], references: [id])
  events       AdEvent[]

  @@index([campaignId])
  @@index([active])
  @@map("ad_creatives")
}

/// Campaign-placement assignment (spec item 5) — decoupled from AdCampaign itself so a campaign can run
/// in several placements at once, each independently enabled/disabled/prioritized without touching the
/// campaign row or its other placements. `priority` overrides AdCampaign.priority for THIS placement
/// only when set; null falls back to the campaign's own priority.
model AdCampaignPlacement {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  placementId String   @map("placement_id")
  priority    Int?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaign  AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([campaignId, placementId])
  @@index([placementId, enabled])
  @@map("ad_campaign_placements")
}

/// Impression/click event foundation (spec item 11) — one table for both event types (`type`) rather
/// than the legacy model's separate AdImpression/AdClick tables, since every other field is identical
/// and a combined CTR query no longer needs a UNION. `context` is a short free-text page identifier
/// (e.g. an article slug or category slug) for future per-page analytics; deliberately not a FK to
/// Article/Category, since an ad placement can appear on pages that have no such row (search, jobs).
model AdEvent {
  id          String      @id @default(uuid())
  type        AdEventType
  campaignId  String      @map("campaign_id")
  creativeId  String      @map("creative_id")
  placementId String      @map("placement_id")
  sessionId   String?     @map("session_id")
  context     String?
  device      String?
  createdAt   DateTime    @default(now()) @map("created_at")

  campaign  AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creative  AdCreative  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placement AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([placementId, createdAt])
  @@index([type, createdAt])
  @@index([campaignId, sessionId, type, createdAt])
  @@map("ad_events")
}

/// Same append-only "who did what, when" pattern as EmployerAuditLog/JobAuditLog (see those models) —
/// free-text `action`/fromStatus/toStatus rather than a closed enum, so a new workflow action never
/// needs a migration. A null campaignId is reserved for placement-registry-level actions (e.g. an admin
/// disabling a whole placement), which are not scoped to any one campaign.
model AdAuditLog {
  id         String   @id @default(uuid())
  campaignId String?  @map("campaign_id")
  actorId    String?  @map("actor_id")
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  campaign AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actor    User?       @relation(fields: [actorId], references: [id])

  @@index([campaignId, createdAt])
  @@index([action, createdAt])
  @@map("ad_audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String   @map("event_type")
  articleId  String?  @map("article_id")
  categoryId String?  @map("category_id")
  locationId String?  @map("location_id")
  adId       String?  @map("ad_id")
  sessionId  String?  @map("session_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([createdAt])
  @@index([articleId])
  @@index([categoryId])
  @@index([locationId])
  @@index([adId])
  @@index([eventType, createdAt])
  @@map("analytics_events")
}

// ==================== JOBS PLATFORM (Phase 2O) ====================

/// Job taxonomy, kept as its own small model rather than reusing the news `Category` tree: job
/// categories (Government, Bank, IT & Software, ...) are a fundamentally different, flatter list than
/// news sections, and keeping them separate means neither taxonomy's admin UI/queries have to filter
/// the other out.
model JobCategory {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  status      JobCategoryStatus @default(ACTIVE)
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  jobs Job[]

  @@index([slug])
  @@index([status])
  @@map("job_categories")
}

/// Employer/company foundation for Phase 2O — admin-managed only (no self-service login/dashboard yet;
/// that is Phase 2P). Deliberately shaped like ReaderProfile (1:1-with-User avatar/logo pattern) so a
/// real employer login can be layered on in Phase 2P by adding a nullable `userId` here rather than
/// redesigning the model.
model Employer {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  logoMediaId  String?        @map("logo_media_id")
  coverMediaId String?        @map("cover_media_id")
  website      String?
  description  String?
  industry     String?
  companySize  String?        @map("company_size")
  foundedYear  Int?           @map("founded_year")
  locationId   String?        @map("location_id")
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  status       EmployerStatus @default(ACTIVE)

  // Phase 2P: self-service employer accounts. An admin-created (Phase 2O) employer has no members and
  // isSelfService=false; registering "I'm hiring" creates the Employer with isSelfService=true and an
  // OWNER EmployerMembership in the same transaction. Both kinds share one Job table — ownership for
  // authorization purposes is always derived from EmployerMembership, never a job/employer type flag.
  isSelfService      Boolean                     @default(false) @map("is_self_service")
  verificationStatus EmployerVerificationStatus  @default(PENDING) @map("verification_status")
  verificationNote   String?                     @map("verification_note")
  verifiedAt         DateTime?                   @map("verified_at")
  verifiedById       String?                     @map("verified_by_id")

  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  logo        Media?               @relation("EmployerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  cover       Media?               @relation("EmployerCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  location    Location?            @relation(fields: [locationId], references: [id])
  createdBy   User?                @relation(fields: [createdById], references: [id])
  verifiedBy  User?                @relation("EmployerVerifiedBy", fields: [verifiedById], references: [id])
  jobs        Job[]
  memberships EmployerMembership[]
  orders      JobPostingOrder[]
  auditLogs   EmployerAuditLog[]

  @@index([slug])
  @@index([status])
  @@index([logoMediaId])
  @@index([verificationStatus])
  @@map("employers")
}

/// Append-only audit trail for employer/company/verification/platform-setting events that are NOT
/// scoped to a single job (JobAuditLog already covers job-scoped events like SUBMITTED/APPROVED). A
/// null employerId records a platform-wide event (e.g. a feature-flag toggle by Super Admin).
model EmployerAuditLog {
  id         String   @id @default(uuid())
  employerId String?  @map("employer_id")
  actorId    String?  @map("actor_id")
  action     String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  employer Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  actor    User?     @relation(fields: [actorId], references: [id])

  @@index([employerId, createdAt])
  @@index([action, createdAt])
  @@map("employer_audit_logs")
}

/// Links a User to the Employer they can act on behalf of (Phase 2P). This — not any field on Job or
/// on the User itself — is the single source of truth for "which company does this person work for /
/// can this person manage". Every employer-scoped API derives employerId by looking up the caller's
/// membership row(s), never from a client-supplied employerId/companyId (IDOR prevention).
model EmployerMembership {
  id          String                    @id @default(uuid())
  employerId  String                    @map("employer_id")
  userId      String                    @map("user_id")
  role        EmployerMembershipRole    @default(RECRUITER)
  status      EmployerMembershipStatus  @default(ACTIVE) @map("status")
  invitedById String?                   @map("invited_by_id")
  invitedAt   DateTime?                 @map("invited_at")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  employer  Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("EmployerMembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([employerId, userId])
  @@index([userId])
  @@index([employerId])
  @@map("employer_memberships")
}

/// A postable plan an employer can choose when creating/promoting a job (Phase 2P monetization
/// foundation). FREE plans have no price; PAID plans carry the amount a real gateway would charge.
/// Purely a catalog/config row — choosing a paid plan does not itself grant anything; see
/// JobPostingOrder for the payment-state machine that actually gates featured placement.
model JobPostingPlan {
  id            String             @id @default(uuid())
  key           String             @unique
  name          String
  type          JobPostingPlanType
  priceAmount   Int?               @map("price_amount")
  priceCurrency String?            @default("BDT") @map("price_currency")
  durationDays  Int                @map("duration_days")
  isFeatured    Boolean            @default(false) @map("is_featured")
  isActive      Boolean            @default(true) @map("is_active")
  sortOrder     Int                @default(0) @map("sort_order")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  orders JobPostingOrder[]

  @@map("job_posting_plans")
}

/// One order per (job, plan) selection. Never created as SUCCEEDED by application code — with no live
/// payment gateway wired up in this phase, every order this codebase creates stays PENDING (or is
/// explicitly CANCELLED/FAILED); SUCCEEDED/REFUNDED are reachable only through a future gateway
/// webhook or an explicit, permissioned admin action, never automatically from job creation.
model JobPostingOrder {
  id          String        @id @default(uuid())
  jobId       String        @map("job_id")
  employerId  String        @map("employer_id")
  planId      String        @map("plan_id")
  amount      Int
  currency    String        @default("BDT")
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?       @map("provider_ref")
  createdById String        @map("created_by_id")
  paidAt      DateTime?     @map("paid_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employer  Employer       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  plan      JobPostingPlan @relation(fields: [planId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([employerId])
  @@index([jobId])
  @@index([status])
  @@map("job_posting_orders")
}

/// Mirrors Article's shape closely (Json rich-text fields, the same DRAFT→...→PUBLISHED→ARCHIVED
/// workflow idea via JobStatus, the same createdBy/updatedBy audit pair) but is intentionally its own
/// model rather than an Article subtype — a job posting has no author/byline concept and instead has
/// employer/salary/deadline/application fields Article has no use for.
model Job {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  summary      String?
  description  Json?
  responsibilities Json?
  requirements Json?
  qualifications   Json?
  experience   String?

  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  salaryCurrency   String?  @default("BDT") @map("salary_currency")
  salaryNegotiable Boolean  @default(false) @map("salary_negotiable")

  employmentType EmploymentType @map("employment_type")
  workplaceType  WorkplaceType @default(ON_SITE) @map("workplace_type")
  vacancies      Int?          @default(1)

  categoryId String  @map("category_id")
  employerId String  @map("employer_id")
  locationId String? @map("location_id")

  applicationMethod       ApplicationMethod @default(INTERNAL) @map("application_method")
  externalApplyUrl        String?           @map("external_apply_url")
  applicationEmail        String?           @map("application_email")
  applicationInstructions String?           @map("application_instructions")

  featured    Boolean   @default(false)
  status      JobStatus @default(DRAFT)
  publishedAt DateTime? @map("published_at")
  scheduledAt DateTime? @map("scheduled_at")
  deadline    DateTime?
  viewCount   Int       @default(0) @map("view_count")

  createdById String   @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category     JobCategory      @relation(fields: [categoryId], references: [id])
  employer     Employer         @relation(fields: [employerId], references: [id])
  location     Location?        @relation(fields: [locationId], references: [id])
  createdBy    User             @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?            @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  applications JobApplication[]
  savedBy      SavedJob[]
  auditLogs    JobAuditLog[]
  postingOrders JobPostingOrder[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([employerId])
  @@index([locationId])
  @@index([status, publishedAt])
  @@index([featured])
  @@index([deadline])
  @@map("jobs")
}

/// Same append-only audit pattern as ArticleAuditLog (see that model for the full rationale) — one
/// table, free-text `action`/fromStatus/toStatus rather than a closed enum, so new workflow actions
/// never require a migration.
model JobAuditLog {
  id         String   @id @default(uuid())
  jobId      String   @map("job_id")
  actorId    String?  @map("actor_id")
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([jobId, createdAt])
  @@map("job_audit_logs")
}

/// Mirrors Bookmark exactly (see that model) — `@@unique([userId, jobId])` is what makes "save" an
/// idempotent upsert instead of needing an application-level duplicate check.
model SavedJob {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@index([jobId])
  @@map("saved_jobs")
}

/// Deliberately its own small model rather than reusing Media: a resume is applicant-owned, private
/// (never listed in the admin Media library, never referenced by public pages) and not necessarily an
/// image, so Media's magic-byte image-signature validation doesn't apply. `isDefault` lets a user keep
/// several resumes and pick which one a new application uses without deleting the others.
model Resume {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  fileName   String   @map("file_name")
  storageKey String   @unique @map("storage_key")
  publicUrl  String   @map("public_url")
  mimeType   String   @map("mime_type")
  size       Int
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([userId])
  @@map("resumes")
}

/// Only ever created for `Job.applicationMethod == INTERNAL` — an EXTERNAL_URL/EMAIL job sends the
/// candidate off-platform instead and no row is created here (see ApplicationMethod). `notes` is an
/// admin-only internal field, never serialized to the applicant-facing API.
model JobApplication {
  id           String            @id @default(uuid())
  jobId        String            @map("job_id")
  applicantId  String            @map("applicant_id")
  resumeId     String?           @map("resume_id")
  coverLetter  String?           @map("cover_letter")
  status       ApplicationStatus @default(SUBMITTED)
  method       ApplicationMethod @default(INTERNAL)
  notes        String?
  reviewedById String?           @map("reviewed_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicant  User     @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  resume     Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@unique([jobId, applicantId])
  @@index([applicantId, createdAt])
  @@index([jobId, status])
  @@index([status])
  @@map("job_applications")
}
