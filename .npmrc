; Render (and other hosts) set NODE_ENV=production before running the build command, and npm
; itself infers omit=dev from that unless told otherwise — which drops turbo, prisma, typescript,
; @nestjs/cli, etc. (all devDependencies needed to actually build this repo) and breaks the build
; with "turbo: not found". Force devDependencies to always install; runtime NODE_ENV is unaffected.
include=dev
