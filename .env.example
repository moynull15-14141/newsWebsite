# Database
# Local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform?schema=public"
# Aiven (or any managed Postgres) - SSL required, never commit the real password:
DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@news-db-diu-93aa.b.aivencloud.com:25713/defaultdb?sslmode=require"

# SAFETY (see docs/DATABASE-SAFETY.md): SHADOW_DATABASE_URL is used by `prisma migrate dev` / `prisma
# migrate diff` to compute schema diffs. Prisma RESETS whatever database this points to. It MUST be a
# separate, disposable local/dev database and MUST NEVER equal DATABASE_URL — especially never the
# production Aiven URL above. Leave unset for local dev against a local Postgres (Prisma will manage a
# temporary shadow DB on the same local server automatically); only set this explicitly when you know
# exactly which disposable database it points to.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform_shadow?schema=public"

# Optional: a separate database for automated tests / CI. Must also never equal DATABASE_URL.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform_test?schema=public"

# Optional: a separate pre-production database for staging deploys. Must also never equal DATABASE_URL.
# STAGING_DATABASE_URL=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# API
# Public URL where the API is reachable (production: the Render service URL, e.g. https://newssite-api.onrender.com).
API_URL="http://localhost:3001"
# Local-dev port override. On Render, the platform injects PORT itself and the app binds to that;
# API_PORT is only consulted as a fallback when PORT is unset (see apps/api/src/main.ts).
API_PORT=3001
# Exact production origins only, comma-separated, no wildcards (e.g. the deployed Vercel web + admin URLs).
API_CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Web
WEB_URL="http://localhost:5173"
WEB_PORT=5173
GOOGLE_NEWS_PUBLICATION_NAME="BD News"

# Admin
ADMIN_URL="http://localhost:5174"
ADMIN_PORT=5174

# Environment
NODE_ENV="development"

# Storage (S3/R2 compatible) — see docs/MEDIA.md and docs/R2-SETUP.md.
#
# `MEDIA_STORAGE_PROVIDER` (local | r2) is the Phase 2R convention; the older `STORAGE_PROVIDER`
# (local | s3) still works unchanged if already set elsewhere — the app accepts either name, checking
# MEDIA_STORAGE_PROVIDER first. Only ever set ONE of them.
MEDIA_STORAGE_PROVIDER="local"
# STORAGE_PROVIDER="local"

# Cloudflare R2 (S3-compatible). Required only when MEDIA_STORAGE_PROVIDER=r2 (or STORAGE_PROVIDER=s3).
# NEVER commit real values here or anywhere else. NEVER prefix these with VITE_ or reference them from
# apps/web or apps/admin — only the NestJS API process may read R2 credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="news-media"
# Leave blank to derive https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com automatically; set explicitly to
# override (e.g. a jurisdiction-specific endpoint).
R2_ENDPOINT=""
# The URL media is actually served from — either R2's own public bucket URL, or (once configured, see
# docs/R2-SETUP.md) a custom domain such as https://media.bdnews.com. Required when using r2/s3.
R2_PUBLIC_URL=""

# Legacy names — still read as a fallback if the R2_* ones above are unset. Safe to ignore for new setups.
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET="news-platform-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="http://localhost:3001/api/v1/media/files"

LOCAL_STORAGE_PATH="./uploads"

# Per-purpose upload size limits (MB). Optional — sensible defaults apply if unset (see
# apps/api/src/modules/media/media-limits.ts): article 10, ad 10, avatar 5, general 20.
# MEDIA_MAX_SIZE_ARTICLE_MB=10
# MEDIA_MAX_SIZE_AD_MB=10
# MEDIA_MAX_SIZE_AVATAR_MB=5
# MEDIA_MAX_SIZE_GENERAL_MB=20

# Seed
# Development-only default. Production requires an explicit secure value.
SEED_ADMIN_PASSWORD="admin123"
