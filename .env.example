# Database
# Local Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform?schema=public"
# Aiven (or any managed Postgres) - SSL required, never commit the real password:
DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@news-db-diu-93aa.b.aivencloud.com:25713/defaultdb?sslmode=require"

# SAFETY (see docs/DATABASE-SAFETY.md): SHADOW_DATABASE_URL is used by `prisma migrate dev` / `prisma
# migrate diff` to compute schema diffs. Prisma RESETS whatever database this points to. It MUST be a
# separate, disposable local/dev database and MUST NEVER equal DATABASE_URL — especially never the
# production Aiven URL above. Leave unset for local dev against a local Postgres (Prisma will manage a
# temporary shadow DB on the same local server automatically); only set this explicitly when you know
# exactly which disposable database it points to.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform_shadow?schema=public"

# Optional: a separate database for automated tests / CI. Must also never equal DATABASE_URL.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/news_platform_test?schema=public"

# Optional: a separate pre-production database for staging deploys. Must also never equal DATABASE_URL.
# STAGING_DATABASE_URL=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# API
API_URL="http://localhost:3001"
API_PORT=3001
API_CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Web
WEB_URL="http://localhost:5173"
WEB_PORT=5173
GOOGLE_NEWS_PUBLICATION_NAME="BD News"

# Admin
ADMIN_URL="http://localhost:5174"
ADMIN_PORT=5174

# Environment
NODE_ENV="development"

# Storage (S3/R2 compatible)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="news-platform-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="http://localhost:3001/api/v1/media/files"
LOCAL_STORAGE_PATH="./uploads"

# Seed
# Development-only default. Production requires an explicit secure value.
SEED_ADMIN_PASSWORD="admin123"
